{
  "version": 2,
  "documentType": "infographic",
  "title": "Método de Cramer",
  "subtitle": "Resolución de sistemas de ecuaciones lineales · Paso a paso",
  "sections": [
    {
      "title": "Idea general",
      "text": "Resuelve sistemas con igual número de ecuaciones e incógnitas mediante determinantes. El determinante principal debe ser distinto de cero.",
      "kind": "key-idea",
      "icon": "bulb",
      "region": "overview"
    },
    {
      "title": "Sistema general",
      "text": "Ordena los coeficientes de cada incógnita en columnas y los términos independientes a la derecha.",
      "formula": "\\begin{cases}a_1x+b_1y=c_1\\\\a_2x+b_2y=c_2\\end{cases}",
      "kind": "formula",
      "region": "overview"
    },
    {
      "title": "Determinantes y regla",
      "text": "A contiene los coeficientes. Para cada incógnita reemplaza su columna por los términos independientes; conserva las otras columnas.",
      "equations": [
        "D=\\det(A)",
        "x=\\frac{D_x}{D}",
        "y=\\frac{D_y}{D}"
      ],
      "kind": "formula",
      "region": "overview"
    },
    {
      "title": "Condición de aplicación",
      "text": "Si D = 0, Cramer no proporciona una solución única. El sistema puede ser incompatible o tener infinitas soluciones; requiere otro análisis.",
      "kind": "warning",
      "region": "overview",
      "icon": "warning"
    },
    {
      "title": "Sistema solicitado",
      "text": "",
      "formula": "\\begin{cases}2x+y=5\\\\x-y=1\\end{cases}",
      "kind": "key-idea",
      "region": "worked-example"
    },
    {
      "title": "Determinante principal",
      "text": "",
      "tone": "pink",
      "equations": [
        "D=\\begin{vmatrix}2&1\\\\1&-1\\end{vmatrix}",
        "D=2\\cdot(-1)-1\\cdot1",
        "D=-3"
      ],
      "kind": "formula",
      "region": "worked-example"
    },
    {
      "title": "Determinante de x",
      "text": "",
      "tone": "blue",
      "equations": [
        "D_x=\\begin{vmatrix}5&1\\\\1&-1\\end{vmatrix}",
        "D_x=5\\cdot(-1)-1\\cdot1",
        "D_x=-6"
      ],
      "kind": "formula",
      "region": "worked-example"
    },
    {
      "title": "Determinante de y",
      "text": "",
      "tone": "green",
      "equations": [
        "D_y=\\begin{vmatrix}2&5\\\\1&1\\end{vmatrix}",
        "D_y=2\\cdot1-5\\cdot1",
        "D_y=-3"
      ],
      "kind": "formula",
      "region": "worked-example"
    },
    {
      "title": "Aplicar las fórmulas",
      "text": "",
      "equations": [
        "x=\\frac{D_x}{D}=\\frac{-6}{-3}=2",
        "y=\\frac{D_y}{D}=\\frac{-3}{-3}=1"
      ],
      "kind": "steps",
      "region": "worked-example"
    },
    {
      "title": "Respuesta final",
      "text": "",
      "equations": [
        "x=\\frac{-6}{-3}=2,\\quad y=\\frac{-3}{-3}=1"
      ],
      "kind": "key-idea",
      "region": "worked-example",
      "icon": "check"
    },
    {
      "title": "Comprobación",
      "text": "",
      "equations": [
        "2\\cdot(\\frac{-6}{-3})+1\\cdot(\\frac{-3}{-3})=5",
        "1\\cdot(\\frac{-6}{-3})-1\\cdot(\\frac{-3}{-3})=1"
      ],
      "kind": "comparison",
      "region": "worked-example",
      "icon": "check"
    }
  ],
