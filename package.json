{
  "name": "@innova-space/visual-scientific-renderer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Local-first scientific rendering stack for Visual Engine.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./node": "./dist/node.js"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "tsc -p tsconfig.build.json",
    "build": "npm run build:lib && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:lib && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "start:blender-worker": "npm run build:lib && node scripts/start-blender-worker.mjs",
    "vendor:runtime": "node scripts/vendor-runtime.mjs",
    "check:runtime-assets": "node scripts/check-runtime-assets.mjs",
    "postinstall": "node scripts/vendor-runtime.mjs",
    "vendor:science-python": "node scripts/vendor-pyodide-science.mjs numpy scipy sympy astropy matplotlib scikit-image",
    "vendor:science-python:download": "node scripts/vendor-pyodide-science.mjs --download numpy scipy sympy astropy matplotlib scikit-image"
  },
  "dependencies": {
    "@bb-studio/exr": "^0.2.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "pyodide": "^0.28.3",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
