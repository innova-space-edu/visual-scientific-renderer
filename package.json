    "check":"npm run typecheck && npm run test && npm run build"
  },
  "dependencies":{"three":"^0.180.0"},
  "devDependencies":{"@types/node":"^24.0.0","@types/three":"^0.180.0","typescript":"^5.9.3","vite":"^7.1.0"},
